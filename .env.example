APP_NAME="Reservasi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Lokal: SQLite (tanpa install apa pun). Untuk produksi ganti ke mysql atau pgsql.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=reservasi
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="reservasi@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Akun admin pertama (dibuat oleh: php artisan db:seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-password-ini
